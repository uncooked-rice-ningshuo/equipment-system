# ============================================================
# 设备借还管理系统 - 环境变量配置示例
# 复制此文件为 .env 并根据需要修改
# ============================================================

# --------------------------------------------------------
# Web 版数据库配置 (PostgreSQL)
# --------------------------------------------------------
# 本地开发
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/equipment"

# Docker 环境
# DATABASE_URL="postgresql://postgres:postgres@db:5432/equipment"

# --------------------------------------------------------
# Better Auth 配置 (Web 版)
# --------------------------------------------------------
# 生成密钥: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-min-32-characters-long"

# 开发环境
BETTER_AUTH_URL="http://localhost:3000"

# 生产环境
# BETTER_AUTH_URL="https://your-domain.com"

# --------------------------------------------------------
# Next.js 配置 (Web 版)
# --------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --------------------------------------------------------
# OAuth 提供商配置 (可选)
# --------------------------------------------------------
# GitHub OAuth
# GITHUB_CLIENT_ID="your-github-client-id"
# GITHUB_CLIENT_SECRET="your-github-client-secret"

# Google OAuth
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --------------------------------------------------------
# Docker 配置
# --------------------------------------------------------
# PostgreSQL
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="equipment"

# --------------------------------------------------------
# CI/CD Secrets (GitHub Actions)
# 这些需要在 GitHub Repository Settings -> Secrets 中配置
# --------------------------------------------------------

# Docker Hub
# DOCKER_USERNAME="your-docker-username"
# DOCKER_PASSWORD="your-docker-password-or-token"

# Vercel (可选)
# VERCEL_TOKEN="your-vercel-token"
# VERCEL_ORG_ID="your-vercel-org-id"
# VERCEL_PROJECT_ID="your-vercel-project-id"

# macOS 代码签名 (可选)
# CSC_LINK="base64-encoded-certificate"
# CSC_KEY_PASSWORD="certificate-password"
# APPLE_ID="your-apple-id"
# APPLE_ID_PASSWORD="your-app-specific-password"
# APPLE_TEAM_ID="your-team-id"

# Windows 代码签名 (可选)
# CSC_LINK_WINDOWS="base64-encoded-certificate"
# CSC_KEY_PASSWORD_WINDOWS="certificate-password"
