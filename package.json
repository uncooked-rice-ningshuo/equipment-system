{
  "name": "equipment-system",
  "version": "1.0.0",
  "private": true,
  "description": "设备借还管理系统（Electron + Umi + AntD + sql.js）",
  "author": "lab-admin",
  "scripts": {
    "dev:web": "umi dev",
    "dev:electron": "wait-on http://localhost:8000 && electron ./electron/main.js",
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:electron\"",
    "build:web": "umi build",
    "build:win": "electron-builder",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "antd": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "dayjs": "^1.11.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sql.js": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.3",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.6.4",
    "electron-is-dev": "^3.0.1",
    "typescript": "^5",
    "umi": "^4.0.46",
    "wait-on": "^7.2.0",
    "prettier": "^2",
    "prettier-plugin-organize-imports": "^3.2.2",
    "prettier-plugin-packagejson": "^2.4.3",
    "husky": "^9",
    "lint-staged": "^13"
  }
}