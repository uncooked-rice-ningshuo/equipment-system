{
  "name": "equipment-system",
  "version": "1.0.0",
  "private": true,
  "description": "设备借还管理系统（Electron + Web 双模式）",
  "author": "lab-admin",
  "scripts": {
    "build": "turbo run build",
    "build:electron": "turbo run build --filter=@equipment/electron-app",
    "build:shared": "pnpm --filter \"@equipment/*\" build",
    "build:web": "turbo run build --filter=@equipment/web",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "dev": "turbo run dev",
    "dev:electron": "turbo run dev --filter=@equipment/electron-app",
    "dev:web": "turbo run dev --filter=@equipment/web",
    "docker:web:down": "cd packages/web && docker-compose down",
    "docker:web:logs": "cd packages/web && docker-compose logs -f",
    "docker:web:up": "cd packages/web && docker-compose up -d",
    "lint": "turbo run lint --filter=@equipment/*",
    "prepare": "husky",
    "release:electron": "pnpm --filter @equipment/electron-app electron:build",
    "test:electron:build": "pnpm --filter @equipment/electron-app test:build"
  },
  "devDependencies": {
    "@types/node": "^20.11.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "husky": "^9",
    "lint-staged": "^13",
    "prettier": "^2",
    "prettier-plugin-organize-imports": "^3.2.2",
    "prettier-plugin-packagejson": "^2.4.3",
    "stylelint": "^14.16.1",
    "turbo": "^2.0.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
